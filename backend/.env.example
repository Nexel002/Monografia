# Assistente do dashboard (opcional). Se faltarem, o assistente fica desligado e o dashboard
# mostra as respostas pré-gravadas; o controlo dos semáforos não depende destas variáveis.

# Chave da API do Gemini. Nunca no Git nem no chat; a que está em .env é a real.
GEMINI_API_KEY=
# Modelo de texto (análise dos resultados, relatório, perguntas escritas).
GEMINI_MODEL=
# Modelo de voz em tempo real (perguntas faladas). Se faltar, a voz usa só o reconhecimento do browser.
GEMINI_LIVE_MODEL=

# Voz do assistente (opcional). A voz é uma camada por cima do texto: sem estas chaves o
# assistente responde só por escrito, e o resto do sistema não é afectado.

# Síntese de voz da Google (texto -> áudio). Se faltar, tenta ElevenLabs; se faltarem as duas, só texto.
GOOGLE_TTS_API_KEY=
# Síntese de voz da ElevenLabs (alternativa, voz mais natural, serviço pago acima do plano gratuito).
ELEVEN_LABS_API_KEY=
# Identificador da voz a usar na ElevenLabs. Se faltar, a ElevenLabs fica desligada mesmo com chave.
ELEVEN_LABS_VOICE_ID=
